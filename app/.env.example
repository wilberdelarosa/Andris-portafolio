# Optional overrides. Confirmed public contact defaults live in src/content/advisor.ts.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_WHATSAPP=
# Public URL of your own secure lead proxy/webhook. Never put the AlterEstate API key here.
NEXT_PUBLIC_LEAD_WEBHOOK_URL=
# Enable indexing only after commercial content, contacts, and rights are approved.
NEXT_PUBLIC_INDEXABLE=false
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Enable after applying 0011_site_visibility_settings.sql in Supabase.
NEXT_PUBLIC_SITE_SETTINGS_ENABLED=false

# Server-side only. Use in a private worker, serverless function, or local test shell.
ALTERESTATE_API_TOKEN=
ALTERESTATE_LEADS_ENDPOINT=https://secure.alterestate.com/api/v1/leads/
ALTERESTATE_TEST_PHONE=+18090000000
ALTERESTATE_TEST_EMAIL=

{
  "name": "andris-pena-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/generate-responsive-images.mjs && node scripts/copy-maplibre-worker.mjs && node --experimental-strip-types scripts/generate-static-api.mjs",
    "prebuild": "node scripts/generate-responsive-images.mjs && node scripts/copy-maplibre-worker.mjs && node --experimental-strip-types scripts/generate-static-api.mjs",
    "prebuild:sites": "node scripts/generate-responsive-images.mjs && node scripts/copy-maplibre-worker.mjs && node --experimental-strip-types scripts/generate-static-api.mjs",
    "images:prepare": "node scripts/generate-responsive-images.mjs",
    "generate:api": "node --experimental-strip-types scripts/generate-static-api.mjs",
    "dev": "next dev --webpack",
    "build": "next build",
    "build:sites": "node scripts/clean-static-output.mjs && next build && node scripts/stage-sites-static.mjs",
    "start": "next start --hostname 0.0.0.0 --port 3000",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:alterestate": "node scripts/test-alterestate-lead.mjs",
    "test:browser": "node scripts/verify-browser.mjs",
    "test:performance": "lhci autorun && node scripts/check-performance-budget.mjs",
    "test:cms-browser": "node scripts/verify-cms-browser.mjs",
    "test:quality": "npm run lint && npm run typecheck && npm test && npm run build:sites",
    "test:updates": "node scripts/check-test-updates.mjs"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@opennextjs/cloudflare": "^1.20.6",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-dialog": "^1.1.23",
    "@types/leaflet": "^1.9.22",
    "@types/three": "^0.186.0",
    "jspdf": "^4.2.1",
    "leaflet": "^1.9.4",
    "lenis": "^1.3.26",
    "maplibre-gl": "^6.9.1",
    "motion": "^13.2.0",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@lhci/cli": "^0.15.1",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "prettier": "^3.9.6",
    "sharp": "^0.35.4",
    "typescript": "^6.0.3",
    "wrangler": "^4.131.1"
  }
}
